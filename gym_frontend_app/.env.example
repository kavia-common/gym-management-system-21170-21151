# Required Supabase configuration for the frontend
REACT_APP_SUPABASE_URL=https://your-project-id.supabase.co
REACT_APP_SUPABASE_KEY=your-anon-or-service-role-key

# Optional site URL for redirect configuration (used in email magic link or signup flows)
# If not set, window.location.origin is used where applicable.
REACT_APP_SITE_URL=http://localhost:3000

# Optional OAuth providers (enable if configured in Supabase)
REACT_APP_GOOGLE_CLIENT_ID=
REACT_APP_GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/auth/callback
