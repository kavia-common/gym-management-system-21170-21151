# Frontend environment example

# App server port (optional)
PORT=3000

# Backend API base URL (existing)
REACT_APP_API_BASE_URL=http://localhost:3001/api/v1

# Optional Google client ID for existing GIS flows
REACT_APP_GOOGLE_CLIENT_ID=

# App environment label (shown in navbar)
REACT_APP_APP_ENV=dev

# Supabase configuration (MANDATORY for Supabase auth)
REACT_APP_SUPABASE_URL=
REACT_APP_SUPABASE_KEY=

# Optional: site URL used for emailRedirectTo during signUp
REACT_APP_SITE_URL=http://localhost:3000
