# Frontend environment
PORT=3000
# Base URL for backend API (ends with /api/v1)
REACT_APP_API_BASE_URL=http://localhost:3001/api/v1

# Optional: Stripe publishable key (if integrating real Stripe later)
REACT_APP_STRIPE_PUBLISHABLE_KEY=pk_test_XXXXXXXXXXXXXXXXXXXXXXXX

# Application environment label for UI (dev|staging|prod)
REACT_APP_APP_ENV=dev

# Test mode switch for payments or mock flows (true|false)
REACT_APP_TEST_MODE=true
