# Frontend environment variables

# App server port (optional)
PORT=3000

# Backend API base URL
REACT_APP_API_BASE_URL=http://localhost:3001/api/v1

# Stripe (optional)
REACT_APP_STRIPE_PUBLISHABLE_KEY=

# App environment label shown in navbar
REACT_APP_APP_ENV=dev

# Test mode flag (optional)
REACT_APP_TEST_MODE=false

# Google Identity Services OAuth Client ID
# Obtain from Google Cloud Console -> Credentials -> OAuth 2.0 Client IDs (Web application)
# Example: 1234567890-abcxyz.apps.googleusercontent.com
REACT_APP_GOOGLE_CLIENT_ID=
