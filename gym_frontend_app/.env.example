# Required by Supabase client in src/lib/supabaseClient.ts
REACT_APP_SUPABASE_URL=https://your-project-id.supabase.co
REACT_APP_SUPABASE_KEY=your-anon-public-key

# Optional: Override OAuth redirect (defaults to window.location.origin + '/auth/callback')
REACT_APP_OAUTH_REDIRECT_URI=https://localhost:3000/auth/callback

# Optional provider placeholders (actual provider config lives in Supabase Dashboard):
# Google
REACT_APP_GOOGLE_CLIENT_ID=
REACT_APP_GOOGLE_CLIENT_SECRET=

# GitHub
REACT_APP_GITHUB_CLIENT_ID=
REACT_APP_GITHUB_CLIENT_SECRET=

# Note:
# - Buttons will be disabled at runtime if Supabase variables are missing.
# - Set REACT_APP_OAUTH_REDIRECT_URI to your deployed URL + /auth/callback when deploying.
# - Configure providers in Supabase → Authentication → Providers, and add the same redirect.
