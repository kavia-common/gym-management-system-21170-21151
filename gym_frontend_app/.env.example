PORT=3000
REACT_APP_API_BASE_URL=http://localhost:3001/api/v1
REACT_APP_APP_ENV=development
REACT_APP_TEST_MODE=true
REACT_APP_DEMO_MODE=true

# Auth providers (Supabase)
# NOTE: Do NOT put any OAuth client secrets in the frontend .env
REACT_APP_SUPABASE_URL=
REACT_APP_SUPABASE_KEY=

# App base URL used for redirects (e.g., http://localhost:3000)
# This is used as default to build `${SITE_URL}/auth/callback` when Supabase is configured.
REACT_APP_SITE_URL=http://localhost:3000

# Google OAuth (frontend-safe)
# Only client ID and redirect URI are read by the frontend.
REACT_APP_GOOGLE_CLIENT_ID=
REACT_APP_GOOGLE_OAUTH_REDIRECT_URI=

# GitHub OAuth (frontend-safe)
# Only client ID and redirect URI are read by the frontend.
REACT_APP_GITHUB_CLIENT_ID=
REACT_APP_GITHUB_OAUTH_REDIRECT_URI=
