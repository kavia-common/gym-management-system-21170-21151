# Frontend environment variables (example)
# Copy this file to .env and fill in the values for your environment.

# Required for Supabase
REACT_APP_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
REACT_APP_SUPABASE_KEY=YOUR_SUPABASE_ANON_KEY

# Optional site URL used for auth redirects (e.g., email confirmation, OAuth callback)
# Example: https://yourdomain.com
REACT_APP_SITE_URL=

# Google OAuth (optional if you use Google)
REACT_APP_GOOGLE_CLIENT_ID=
REACT_APP_GOOGLE_OAUTH_REDIRECT_URI=

# GitHub OAuth (optional if you use GitHub)
REACT_APP_GITHUB_CLIENT_ID=
REACT_APP_GITHUB_OAUTH_REDIRECT_URI=
