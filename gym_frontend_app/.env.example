# Environment variables for Supabase
# Copy this file to ".env" and set the values accordingly.
# If using Vite, use the VITE_* variables.
# If using Create React App (CRA), use the REACT_APP_* variables.

# Vite
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# CRA (Create React App)
REACT_APP_SUPABASE_URL=
REACT_APP_SUPABASE_ANON_KEY=
