# Minimal environment variables required for Supabase and OAuth redirect handling.
# Replace placeholders with your actual values.

REACT_APP_SUPABASE_URL=your-supabase-url
REACT_APP_SUPABASE_KEY=your-supabase-anon-key
REACT_APP_OAUTH_REDIRECT_URI_PROD=https://your-production-domain.com/auth/callback
REACT_APP_OAUTH_REDIRECT_URI_LOCAL=http://localhost:3000/auth/callback
