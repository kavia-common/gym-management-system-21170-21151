# Supabase configuration
# Use one of the following depending on your build system.
# - For Create React App (CRA): use REACT_APP_* variables.
# - For Vite: use VITE_* variables.

# CRA (Create React App) variables
REACT_APP_SUPABASE_URL=https://your-project-ref.supabase.co
REACT_APP_SUPABASE_ANON_KEY=your-anon-key

# Vite variables
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Notes:
# - The app resolves variables with precedence:
#   1) REACT_APP_SUPABASE_URL / REACT_APP_SUPABASE_ANON_KEY
#   2) VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY
#   3) window.__SUPABASE_URL / window.__SUPABASE_ANON_KEY provided at runtime (advanced)
# - Do not commit your real keys to version control. Use a local .env and CI secrets for deployments.
