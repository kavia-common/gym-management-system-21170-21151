# Required for Supabase client
REACT_APP_SUPABASE_URL=
REACT_APP_SUPABASE_KEY=

# Used for constructing redirect URLs in magic link flow
REACT_APP_SITE_URL=http://localhost:3000

# Optional Google OAuth support (button shows only if client id is set)
REACT_APP_GOOGLE_CLIENT_ID=
REACT_APP_GOOGLE_CLIENT_SECRET=
REACT_APP_GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/auth/callback
